# Copy to .env.local (never committed). Only GOOGLE_TTS_KEY is secret.
GOOGLE_TTS_KEY=
# Optional accounts (Supabase → Project Settings → API Keys: the publishable key, never the secret key). Safe to expose: protected by row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Google's own sign-in button (shows this site's address): the OAuth *Client ID* (public), same as in Supabase.
VITE_GOOGLE_CLIENT_ID=
# Fallback without the Client ID: set to 1 for Supabase's redirect sign-in.
VITE_SUPABASE_GOOGLE=
