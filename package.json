{
  "name": "hablo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "audio": "tsx scripts/generate-audio.ts",
    "audio:es": "tsx scripts/generate-audio.ts --verbs",
    "audio:de": "HABLO_LANG=de tsx scripts/generate-audio.ts --verbs",
    "audio:fr": "HABLO_LANG=fr tsx scripts/generate-audio.ts --verbs",
    "audio:ru": "HABLO_LANG=ru tsx scripts/generate-audio.ts --verbs",
    "audio:deploy": "tsx scripts/generate-audio.ts --verbs --optional && HABLO_LANG=de tsx scripts/generate-audio.ts --verbs --optional && HABLO_LANG=fr tsx scripts/generate-audio.ts --verbs --optional && HABLO_LANG=ru tsx scripts/generate-audio.ts --verbs --optional",
    "build:app": "tsc && vite build && node -e \"require('fs').rmSync('dist/audio',{recursive:true,force:true})\" && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
